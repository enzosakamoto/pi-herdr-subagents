{
  "name": "pi-herdr-subagents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asynchronous visible pi subagents in Herdr panes",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
